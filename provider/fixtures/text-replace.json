{
  "$comment": "replaceAllText's reply carries occurrencesChanged; drawn so a host sees a number, not the 0 that means not found.",
  "operation": "text_replace",
  "response": {
    "documentId": {
      "$config": "documentId",
      "as": "string",
      "fallback": {
        "$fake": "id",
        "prefix": "1Doc"
      }
    },
    "replies": [
      {
        "replaceAllText": {
          "occurrencesChanged": {
            "$fake": "int",
            "min": 1,
            "max": 9
          }
        }
      }
    ],
    "writeControl": {
      "requiredRevisionId": {
        "$fake": "hex",
        "length": 16
      }
    }
  }
}
